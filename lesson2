def shout(func):
    @wraps(func)
    def wrapper(*args, **kwargs):
        return func(*args, **kwargs)
    return wrapper

@shout
def greet(name):
    name = name.upper()
    name = name + "!!!"
    return f"salam, {name}" 

def countdown(n):
    while n > 0:
        yield n
        n -= 1
    if n == 0:
        yield "Start!"
        
for x in countdown(3):
    print(x)

